import sys

# Reading input
n = int(input().strip())
a = list(map(int, input().strip().split(' ')))

total_swaps = 0

# Bubble Sort logic
for i in range(n):
    # Track swaps for this specific pass
    swaps_in_pass = 0
    
    for j in range(n - 1):
        # Swap if elements are in the wrong order
        if a[j] > a[j+1]:
            a[j], a[j+1] = a[j+1], a[j]
            swaps_in_pass += 1
            total_swaps += 1
            
    # Optimization: if no elements were swapped, array is sorted
    if swaps_in_pass == 0:
        break

# Output formatting
print(f"Array is sorted in {total_swaps} swaps.")
print(f"First Element: {a[0]}")
print(f"Last Element: {a[-1]}")
